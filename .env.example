# Clerk — https://dashboard.clerk.com → API Keys
# PRODUCTION (Vercel / pookiestudios.in): Use LIVE keys only. Clerk mode = key type.
#   - Publishable must start with: pk_live_
#   - Secret must start with: sk_live_
# LOCAL DEV: You may use test keys (pk_test_, sk_test_). Never use test keys in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Login uses Clerk hosted sign-in (SignInButton mode="redirect"). Do NOT set SIGN_IN_URL to /sign-in.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/download
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/download

# Stripe — https://dashboard.stripe.com/test/apikeys (use Test mode)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price IDs (one-time payment). Create in Dashboard → Products → Add product → Add price (INR / USD).
# Then copy each Price ID (e.g. price_xxx) into the matching env var.
STRIPE_PRICE_BASE_INR=price_...
STRIPE_PRICE_BASE_USD=price_...
STRIPE_PRICE_FULL_INR=price_...
STRIPE_PRICE_FULL_USD=price_...

# App URL for Stripe success/cancel redirects (required for production)
# Local: leave unset or use http://localhost:3000
# Vercel: https://pookiestudios.in (or your deployment URL)
NEXT_PUBLIC_APP_URL=https://pookiestudios.in
